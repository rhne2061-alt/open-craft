---
import Base from '../layouts/Base.astro';
import ResourceCard from '../components/ResourceCard.astro';
import { resources, url, repo } from '../lib/catalog';
---
<Base>
  <section class="hero wrap">
    <div class="hero-copy"><p class="eyebrow"><span class="status-dot"></span> A COMMON SPACE FOR UNCOMMON IDEAS</p><h1>好的创造，<br/>向<span class="serif-accent">所有人</span>开放<span class="green-dot">。</span></h1><p class="hero-description">AI 时代的开放创作资源库。<br/>带走一个灵感、一段代码，带回你的下一次创造。</p><div class="hero-actions"><a class="button primary" href="#library">探索开放资源 <span>↗</span></a><a class="text-link" href={url('contribute/')}>贡献你的作品 <span>＋</span></a></div><div class="hero-note"><span>免费取用</span><span>源码开放</span><span>共同生长</span></div></div>
    <div class="hero-visual" aria-label="互相连接的开放资源：提示词、代码与创意"><div class="visual-grid"></div><div class="visual-top"><span>THE OPEN LOOP</span><span>V.01</span></div><div class="visual-orbit orbit-one"></div><div class="visual-orbit orbit-two"></div><div class="visual-center">✳</div><span class="float-label label-code">&lt;/&gt; CODE</span><span class="float-label label-prompt">✦ PROMPT</span><span class="float-label label-remix">↗ REMIX</span><div class="visual-bottom"><span>TAKE AN IDEA.<br/>GIVE IT A NEW LIFE.</span><span class="visual-plus">＋</span></div></div>
  </section>
  <section class="manifesto"><div class="wrap manifesto-inner"><span class="eyebrow">BUILT TO BE SHARED</span><p>一个人创造，<strong>所有人都能继续。</strong></p><a href={repo}>查看开源计划 ↗</a></div></section>
  <section id="library" class="library wrap" aria-labelledby="library-title"><div class="section-heading"><div><p class="eyebrow">THE RESOURCE LIBRARY</p><h2 id="library-title">下一次创造，从这里开始。</h2></div><span class="count-label">{resources.length} 个原创起点 · 持续共创</span></div>
    <div class="library-tools"><div class="filters" role="group" aria-label="资源分类"><button data-filter="all" aria-pressed="true">全部资源 <span>{resources.length}</span></button><button data-filter="section" aria-pressed="false">页面区块</button><button data-filter="component" aria-pressed="false">交互组件</button><button data-filter="background" aria-pressed="false">视觉背景</button></div><label class="search"><span aria-hidden="true">⌕</span><input id="search" type="search" placeholder="搜索灵感、技术、风格…" aria-label="搜索资源" /></label></div>
    <p id="result-count" class="sr-only" aria-live="polite">找到 {resources.length} 个资源</p>
    <div class="resource-grid">{resources.map((item, index) => <ResourceCard item={item} index={index} />)}</div>
    <div id="empty-state" class="empty-state" hidden><h3>这个灵感，还在等你创造。</h3><p>试试其他关键词，或成为第一个贡献它的人。</p><button id="reset-search" class="button">清除筛选</button></div>
  </section>
  <section class="contribute-banner wrap"><div><p class="eyebrow">YOUR NEXT COMMIT MATTERS</p><h2>不只是使用者。<br/>也是下一位创造者。</h2><p>一个好的提示词、一段用心的代码、一次小小的修复。<br/>每一种贡献，都让开放多一种可能。</p><a class="button primary" href={url('contribute/')}>提交你的第一个作品 ↗</a></div><div class="steps"><div><span>01</span><p>发现与取用<small>看效果，复制提示词，获取源码。</small></p></div><div><span>02</span><p>修改与创造<small>把开放的起点，变成自己的表达。</small></p></div><div><span>03</span><p>分享与贡献<small>提交 PR，让下一位创作者继续。</small></p></div></div></section>
</Base>
<script>
  let category = 'all';
  const search = document.querySelector<HTMLInputElement>('#search')!;
  const cards = [...document.querySelectorAll<HTMLElement>('[data-card]')];
  const filters = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  function update() {
    const query = search.value.trim().toLocaleLowerCase();
    let count = 0;
    for (const card of cards) { const visible = (category === 'all' || card.dataset.category === category) && card.dataset.search!.includes(query); card.hidden = !visible; if (visible) count++; }
    document.querySelector('#result-count')!.textContent = `找到 ${count} 个资源`;
    (document.querySelector('#empty-state') as HTMLElement).hidden = count !== 0;
    filters.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.filter === category)));
  }
  search.addEventListener('input', update);
  filters.forEach(button => button.addEventListener('click', () => { category = button.dataset.filter!; update(); }));
  document.querySelector('#reset-search')!.addEventListener('click', () => { category = 'all'; search.value = ''; update(); search.focus(); });
</script>
